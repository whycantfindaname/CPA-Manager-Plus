{
  "schema": "jason-agent-infra.managed-project-workflow.v1",
  "project_id": "cpamp",
  "commands": {
    "frontend_verification": {
      "argv": [
        "npm",
        "run",
        "test",
        "--",
        "--maxWorkers=1",
        "--testTimeout=20000"
      ],
      "cwd": ".",
      "timeout_seconds": 1800,
      "mutates": []
    },
    "backend_verification": {
      "argv": ["npm", "run", "manager-server:test"],
      "cwd": ".",
      "timeout_seconds": 1800,
      "mutates": []
    }
  },
  "stages": [
    {
      "id": "project_workflow_frontend",
      "stage": "project_workflow",
      "command": "frontend_verification",
      "depends_on": [],
      "allowed_mutations": [],
      "failure_policy": "stop_project",
      "verification_level": "source",
      "error_catalog": ["CPAMP_FRONTEND_VERIFY_FAILED"]
    },
    {
      "id": "project_workflow_backend",
      "stage": "project_workflow",
      "command": "backend_verification",
      "depends_on": ["project_workflow_frontend"],
      "allowed_mutations": [],
      "failure_policy": "stop_project",
      "verification_level": "source",
      "error_catalog": ["CPAMP_BACKEND_VERIFY_FAILED"]
    }
  ],
  "docs": {
    "guide": ".jason-liao-agent-infra/README.md",
    "errors": ".jason-liao-agent-infra/errors.md"
  }
}
